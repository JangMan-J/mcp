{
  "id": "ver/era-cache-memory-only",
  "requirements": [
    "VER-CACHE-1"
  ],
  "pin": "tag",
  "source": [
    "S/basic/versioning.md#Backward Compatibility with Initialization-Based Versions"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "probe",
      "as": "p1"
    },
    {
      "expect": "wire",
      "index": 0,
      "match": {
        "method": "server/discover"
      }
    },
    {
      "server": "result",
      "for": "p1",
      "result": {
        "resultType": "complete",
        "supportedVersions": [
          "2026-07-28"
        ],
        "capabilities": {
          "tools": {}
        },
        "ttlMs": 0,
        "cacheScope": "private",
        "_meta": {
          "io.modelcontextprotocol/serverInfo": {
            "name": "legacy-looking-server",
            "version": "0.0.1"
          }
        }
      }
    },
    {
      "do": "probe",
      "as": "p2"
    },
    {
      "advance": 10000
    }
  ],
  "expect": {
    "outcome": {
      "p1": {
        "era": "modern"
      },
      "p2": {
        "era": "modern",
        "version": "2026-07-28"
      }
    },
    "wire": {
      "totalRequests": 1,
      "count": {
        "server/discover": 1
      }
    }
  },
  "mutants": [
    "no-era-cache"
  ]
}
