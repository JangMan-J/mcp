      "authorization_response_iss_parameter_supported": true
    }
  },
  "script": [
    {
      "do": "challenge"
    },
    {
      "server": "update",
      "callback": {
        "iss": null
      }
    },
    {
      "do": "challenge",
      "error": "auth-failure/issuer-mismatch"
    },
    {
      "server": "update",
      "callback": {
        "iss": "https://evil.test"
      }
    },
    {
      "do": "challenge",
      "error": "auth-failure/issuer-mismatch"
    },
    {
      "server": "update",
      "metadata": {
        "authorization_response_iss_parameter_supported": false
      }
    },
    {
      "do": "challenge",
      "error": "auth-failure/issuer-mismatch"
    },
    {
      "server": "update",
      "callback": {
        "iss": "https://as.test/tenant"
      }
    },
    {
      "do": "challenge"
    },
    {
      "server": "update",
      "callback": {
        "iss": null
      }
    },
    {
      "do": "challenge"
    },
    {
      "expect": "counts",
      "match": {
        "token": 3
      }
    }
  ],
  "expect": {},
  "mutants": [
    "wrong-issuer-policy"
  ]
