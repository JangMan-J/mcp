{
  "id": "ext/cc/secret-not-logged",
  "requirements": [
    "EXT-cc-9"
  ],
  "pin": "ext-page",
  "source": [
    "extensions/auth/oauth-client-credentials.md#Client Secrets"
  ],
  "tier": "A",
  "binding": "http",
  "client": {
    "mode": "secret",
    "metadata": {
      "token_endpoint_auth_methods_supported": [
        "client_secret_post"
      ]
    }
  },
  "script": [
    {
      "do": "header"
    },
    {
      "expect": "outcome",
      "value": {
        "authorization": "Bearer tok-1"
      }
    },
    {
      "do": "challenge",
      "status": 401,
      "challenge": "Bearer"
    },
    {
      "expect": "no-leak"
    }
  ],
  "expect": {},
  "mutants": [
    "log-secret",
    "log-token"
  ]
}
