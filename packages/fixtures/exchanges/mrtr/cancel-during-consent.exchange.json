{
  "id": "mrtr/cancel-during-consent",
  "requirements": [
    "MRTR-CANCEL-1"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/patterns/mrtr.md#Basic Workflow"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake",
    "setup": {
      "replies": [
        {
          "resultType": "input_required",
          "inputRequests": {
            "pick": {
              "method": "elicitation/create",
              "params": {
                "message": "Choose a city",
                "requestedSchema": {
                  "type": "object",
                  "properties": {
                    "city": {
                      "type": "string",
                      "minLength": 1,
                      "default": "Oslo"
                    }
                  },
                  "required": [
                    "city"
                  ]
                }
              }
            }
          }
        }
      ],
      "form": true,
      "decisions": [
        "wait"
      ]
    }
  },
  "script": [
    {
      "do": "call",
      "method": "tools/call",
      "params": {},
      "pending": true
    },
    {
      "do": "abort",
      "target": "call"
    }
  ],
  "expect": {
    "observe": {
      "ui.length": 1,
      "wire.length": 1,
      "call.kind": "cancelled",
      "call.phase": "input"
    }
  },
  "mutants": [
    "raw-result"
  ]
}
