{
  "id": "auth/token-not-in-query",
  "requirements": [
    "AUTH-USE-2"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/authorization/index.md#Token Requirements"
  ],
  "tier": "A",
  "binding": "http",
  "client": {},
  "script": [
    {
      "do": "challenge"
    },
    {
      "expect": "header",
      "value": "Bearer fixture-token-1"
    },
    {
      "expect": "open",
      "url": "https://as.test/authorize",
      "match": {
        "resource": "https://mcp.test/rpc"
      },
      "absent": [
        "access_token",
        "token"
      ]
    },
    {
      "expect": "fetches",
      "values": [
        "GET https://mcp.test/custom-prm",
        "GET https://as.test/.well-known/oauth-authorization-server/tenant",
        "POST https://as.test/token"
      ]
    }
  ],
  "expect": {},
  "mutants": [
    "no-provider"
  ]
}
