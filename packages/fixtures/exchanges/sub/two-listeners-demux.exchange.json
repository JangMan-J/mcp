{
  "id": "sub/two-listeners-demux",
  "requirements": [
    "SUB-ROUTE-1",
    "SUB-MULTI-1"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/patterns/subscriptions.md#Receiving Notifications",
    "specification/2026-07-28/basic/patterns/subscriptions.md#Multiple Concurrent Subscriptions"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "clock": "fake",
    "setup": {}
  },
  "script": [
    {
      "do": "listen",
      "as": "a",
      "filter": {
        "tools": true
      }
    },
    {
      "do": "listen",
      "as": "b",
      "filter": {
        "prompts": true
      }
    },
    {
      "do": "notify",
      "target": "b",
      "method": "notifications/subscriptions/acknowledged",
      "params": {
        "notifications": {
          "promptsListChanged": true
        }
      }
    },
    {
      "do": "notify",
      "target": "b",
      "method": "notifications/prompts/list_changed",
      "params": {}
    },
    {
      "do": "notify",
      "target": "a",
      "method": "notifications/subscriptions/acknowledged",
      "params": {
        "notifications": {
          "toolsListChanged": true
        }
      }
    },
    {
      "do": "notify",
      "target": "a",
      "method": "notifications/tools/list_changed",
      "params": {}
    },
    {
      "do": "notify",
      "target": "a",
      "method": "notifications/tools/list_changed",
      "params": {},
      "id": 99
    }
  ],
  "expect": {
    "observe": {
      "aEvents": [
        "notifications/tools/list_changed"
      ],
      "bEvents": [
        "notifications/prompts/list_changed"
      ],
      "diags": [
        "subscription-id-mismatch"
      ]
    }
  },
  "mutants": [
    "drop-route"
  ]
}
