{
  "id": "ext/cc/expiry-single-flight",
  "requirements": [
    "EXT-cc-7"
  ],
  "pin": "ext-page",
  "source": [
    "extensions/auth/oauth-client-credentials.md#Implementation guide"
  ],
  "tier": "A",
  "binding": "http",
  "client": {
    "mode": "jwt-es256",
    "expiresIn": 60
  },
  "script": [
    {
      "do": "parallel",
      "count": 3
    },
    {
      "expect": "outcome",
      "value": {
        "authorizations": [
          "Bearer tok-1",
          "Bearer tok-1",
          "Bearer tok-1"
        ]
      }
    },
    {
      "expect": "token-requests",
      "count": 1
    },
    {
      "do": "advance",
      "ms": 61000
    },
    {
      "do": "header"
    },
    {
      "expect": "outcome",
      "value": {
        "authorization": "Bearer tok-2"
      }
    },
    {
      "expect": "token-requests",
      "count": 2
    },
    {
      "do": "challenge",
      "status": 401,
      "challenge": "Bearer"
    },
    {
      "expect": "outcome",
      "value": {
        "retry": true
      }
    },
    {
      "expect": "token-requests",
      "count": 3
    },
    {
      "do": "header"
    },
    {
      "expect": "outcome",
      "value": {
        "authorization": "Bearer tok-3"
      }
    },
    {
      "expect": "token-requests",
      "count": 3
    }
  ],
  "expect": {},
  "mutants": [
    "no-single-flight",
    "ignore-expiry"
  ]
}
