{
  "id": "auth/iss-table",
  "requirements": [
    "AUTH-ISS-2"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/authorization/index.md#Authorization Response Validation"
  ],
  "tier": "B",
  "binding": "http",
  "client": {
