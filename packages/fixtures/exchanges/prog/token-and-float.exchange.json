{
  "id": "prog/token-and-float",
  "requirements": [
    "PROG-1",
    "PROG-5"
  ],
  "pin": "tag",
  "source": [
    "S/basic/patterns/progress.md#Progress Flow"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "method": "tools/call",
      "params": {
        "name": "long_job"
      },
      "progress": true
    },
    {
      "expect": "wire",
      "index": 0,
      "match": {
        "params._meta.io.modelcontextprotocol/progressToken": 1
      }
    },
    {
      "server": "notify",
      "for": "c1",
      "notification": {
        "jsonrpc": "2.0",
        "method": "notifications/progress",
        "params": {
          "progressToken": 1,
          "progress": 0.5,
          "total": 2.5
        }
      }
    },
    {
      "server": "notify",
      "for": "c1",
      "notification": {
        "jsonrpc": "2.0",
        "method": "notifications/progress",
        "params": {
          "progressToken": 1,
          "progress": 1.25,
          "total": 2.5,
          "message": "halfway"
        }
      }
    },
    {
      "server": "result",
      "for": "c1",
      "result": {
        "resultType": "complete",
        "content": []
      }
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "ok"
      }
    },
    "progress": {
      "c1": [
        0.5,
        1.25
      ]
    },
    "stats": {
      "progress.delivered": 2,
      "progress.active": 0
    }
  },
  "mutants": [
    "integer-only-progress"
  ]
}
