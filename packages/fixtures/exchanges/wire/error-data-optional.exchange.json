{
  "id": "wire/error-data-optional",
  "requirements": [
    "WIRE-ERR-4",
    "EDGE-32"
  ],
  "pin": "tag",
  "source": [
    "S/schema.md#`MethodNotFoundError`",
    "S/server/resources.md#Error Handling"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "method": "prompts/list"
    },
    {
      "do": "call",
      "as": "c2",
      "method": "tools/call",
      "params": {
        "name": "x"
      }
    },
    {
      "do": "call",
      "as": "c3",
      "method": "resources/read",
      "params": {
        "uri": "file:///missing"
      }
    },
    {
      "server": "error",
      "for": "c1",
      "error": {
        "code": -32601,
        "message": "Method not found"
      }
    },
    {
      "server": "error",
      "for": "c2",
      "error": {
        "code": -32602,
        "message": "Invalid params"
      }
    },
    {
      "server": "error",
      "for": "c3",
      "error": {
        "code": -32002,
        "message": "Resource not found"
      }
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "jsonrpc-error",
        "code": -32601,
        "message": "Method not found"
      },
      "c2": {
        "kind": "jsonrpc-error",
        "code": -32602
      },
      "c3": {
        "kind": "jsonrpc-error",
        "code": -32002,
        "refined": "resource-not-found"
      }
    },
    "wire": {
      "totalRequests": 3
    }
  },
  "mutants": [
    "drop-error-refinement"
  ]
}
