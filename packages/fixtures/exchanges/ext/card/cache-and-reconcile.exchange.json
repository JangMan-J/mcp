{
  "id": "ext/card/cache-and-reconcile",
  "requirements": ["EXT-card-4", "EXT-card-5"],
  "pin": "ext-server-card@28db12c9b4a379489d46e49bf1bd4a991f05c9b7",
  "source": ["seps/2127-mcp-server-cards.md#Security Implications", "seps/2127-mcp-server-cards.md#Relationship to `server/discover`"],
  "tier": "A",
  "binding": "http",
  "serve": {
    "https://mcp.test/server-card": [
      { "headers": { "cache-control": "max-age=60", "etag": "\"v1\"" }, "body": { "$schema": "s", "name": "srv", "version": "1.0.0", "description": "d",
        "remotes": [{ "type": "streamable-http", "url": "https://mcp.test/mcp", "supportedVersions": ["2026-07-28"] }] } },
      { "status": 304, "headers": { "cache-control": "max-age=60" } }
    ]
  },
  "script": [
    { "do": "card", "url": "https://mcp.test/server-card" },
    { "do": "card", "url": "https://mcp.test/server-card" },
    { "expect": "fetches", "values": ["GET https://mcp.test/server-card"] },
    { "do": "advance", "ms": 61000 },
    { "do": "card", "url": "https://mcp.test/server-card" },
    { "expect": "last-header", "name": "if-none-match", "value": "\"v1\"" },
    { "expect": "error", "value": null },
    { "do": "card", "url": "https://mcp.test/server-card" },
    { "expect": "fetches", "values": ["GET https://mcp.test/server-card", "GET https://mcp.test/server-card"] },
    { "do": "reconcile", "live": { "cacheScope": "public", "capabilities": {}, "resultType": "complete", "supportedVersions": ["2026-07-28", "2026-12-01"], "serverInfo": { "name": "srv", "version": "1.1.0" } } },
    { "expect": "reconcile", "value": {
      "effective": { "cacheScope": "public", "capabilities": {}, "resultType": "complete", "supportedVersions": ["2026-07-28", "2026-12-01"], "serverInfo": { "name": "srv", "version": "1.1.0" } },
      "mismatches": ["version", "supportedVersions"]
    } }
  ],
  "expect": {},
  "mutants": ["ignore-cache", "no-etag", "card-wins"]
}
