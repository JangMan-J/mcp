{
  "id": "consent/client-info-payload",
  "requirements": [
    "CONSENT-9"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/authorization/client-registration.md#Pre-registration"
  ],
  "tier": "A",
  "binding": "http",
  "client": {
    "registration": "prompt"
  },
  "script": [
    {
      "do": "challenge"
    },
    {
      "expect": "prompt",
      "match": {
        "kind": "client-info",
        "serverLabel": "Fixture MCP",
        "issuer": "https://as.test/tenant",
        "redirectUri": "http://127.0.0.1:4321/callback"
      }
    },
    {
      "expect": "prompt",
      "match": {
        "kind": "authorize",
        "serverLabel": "Fixture MCP",
        "issuerHost": "as.test",
        "resource": "https://mcp.test/rpc",
        "scopes": [
          "read"
        ],
        "redirectHost": "127.0.0.1",
        "localhostWarning": true
      },
      "index": 1
    },
    {
      "expect": "form",
      "match": {
        "client_id": "fixture-client"
      }
    }
  ],
  "expect": {},
  "mutants": [
    "always-decline"
  ]
}
