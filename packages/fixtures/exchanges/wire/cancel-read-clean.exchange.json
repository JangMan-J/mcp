{
  "id": "wire/cancel-read-clean",
  "requirements": [
    "WIRE-CANCEL-5"
  ],
  "pin": "tag",
  "source": [
    "S/basic/patterns/cancellation.md#Behavior Requirements"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "method": "resources/read",
      "params": {
        "uri": "file:///a"
      }
    },
    {
      "expect": "wire",
      "index": 0
    },
    {
      "do": "abort",
      "target": "c1"
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "cancelled",
        "wasSent": true,
        "phase": "wire"
      }
    },
    "wire": {
      "totalRequests": 1
    }
  },
  "mutants": [
    "treat-no-methods-read-only"
  ]
}
