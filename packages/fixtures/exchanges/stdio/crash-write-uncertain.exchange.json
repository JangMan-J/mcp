{
  "id": "stdio/crash-write-uncertain",
  "requirements": ["STDIO-CRASH-1", "STDIO-RECOVER-1"],
  "pin": "tag",
  "source": ["S/basic/transports/stdio.md#Unexpected Termination"],
  "tier": "B",
  "binding": "stdio",
  "client": { "clock": "realtime" },
  "script": [
    { "do": "call", "as": "c1", "method": "tools/call", "params": { "name": "create_item" } },
    { "expect": "wire", "index": 0, "match": { "method": "tools/call" } }
  ],
  "expect": {
    "outcome": {
      "c1": { "kind": "uncertain-write", "uncertain.evidence": "process-exit", "uncertain.binding": "stdio" }
    },
    "wire": { "totalRequests": 1 }
  },
  "mutants": ["auto-retry-tools-call-after-crash"]
}
