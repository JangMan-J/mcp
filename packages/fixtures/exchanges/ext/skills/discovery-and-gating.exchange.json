{
  "id": "ext/skills/discovery-and-gating",
  "requirements": ["EXT-skills-1", "EXT-skills-3", "EXT-skills-4", "EXT-skills-15", "EXT-skills-16"],
  "pin": "ext-page",
  "source": ["W/extensions/skills/overview.md#Capabilities"],
  "tier": "A",
  "binding": "any",
  "server": {
    "capabilities": {
      "resources": {},
      "extensions": { "io.modelcontextprotocol/skills": {} }
    }
  },
  "script": [
    {
      "do": "call",
      "as": "noRes",
      "method": "skills/list",
      "params": { "overrideCaps": { "extensions": { "io.modelcontextprotocol/skills": {} } } }
    },
    { "do": "call", "as": "listOk", "method": "skills/list" },
    {
      "server": "result",
      "for": "listOk",
      "result": {
        "skills": [
          {
            "uri": "skill://s/lint",
            "name": "lint",
            "description": "Run linter",
            "files": [
              { "uri": "skill://s/lint/SKILL.md", "size": 50, "sha256": "444505125cd0f6a97acc4714cef98420a7e83b636212ee4ec8759a52cbf7be48" }
            ]
          }
        ],
        "ttlMs": 60000,
        "cacheScope": "server"
      }
    },
    { "do": "call", "as": "splitPage", "method": "skills/list", "params": { "cursor": "p2" } },
    {
      "server": "result",
      "for": "splitPage",
      "result": {
        "skills": [{ "uri": "skill://s/partial", "name": "partial", "description": "Missing files" }]
      }
    },
    { "do": "call", "as": "getDirect", "method": "skills/get", "params": { "uri": "skill://s/direct" } },
    {
      "server": "result",
      "for": "getDirect",
      "result": {
        "skill": {
          "uri": "skill://s/direct",
          "name": "lint",
          "description": "Run linter",
          "files": [
            { "uri": "skill://s/direct/SKILL.md", "size": 50, "sha256": "444505125cd0f6a97acc4714cef98420a7e83b636212ee4ec8759a52cbf7be48" }
          ]
        },
        "ttlMs": 30000,
        "cacheScope": "session"
      }
    },
    { "do": "call", "as": "getUnknown", "method": "skills/get", "params": { "uri": "skill://s/missing" } },
    {
      "server": "error",
      "for": "getUnknown",
      "error": { "code": -32602, "message": "unknown skill uri" }
    }
  ],
  "expect": {
    "outcome": {
      "noRes": { "kind": "capability-absent" },
      "listOk": { "kind": "ok", "count": 1, "resultType": "complete", "ttlMs": 60000, "cacheScope": "server" },
      "splitPage": { "kind": "protocol-violation" },
      "getDirect": { "kind": "ok", "uri": "skill://s/direct", "resultType": "complete", "ttlMs": 30000, "cacheScope": "session" },
      "getUnknown": { "kind": "jsonrpc-error", "code": -32602 }
    },
    "wire": {
      "count": { "skills/list": 2, "skills/get": 2 }
    }
  },
  "mutants": ["call-without-resources", "split-manifest-across-pages", "drop-cache-fields", "retry-on-32602"]
}
