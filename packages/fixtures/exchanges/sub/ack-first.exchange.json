{
  "id": "sub/ack-first",
  "requirements": [
    "SUB-ACK-1",
    "SUB-ACK-3"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/patterns/subscriptions.md#Acknowledgment"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake",
    "setup": {}
  },
  "script": [
    {
      "do": "listen",
      "as": "a",
      "filter": {
        "tools": true
      }
    },
    {
      "do": "notify",
      "target": "a",
      "method": "notifications/tools/list_changed",
      "params": {}
    },
    {
      "do": "notify",
      "target": "a",
      "method": "notifications/subscriptions/acknowledged",
      "params": {
        "notifications": {
          "toolsListChanged": true
        }
      }
    },
    {
      "do": "notify",
      "target": "a",
      "method": "notifications/tools/list_changed",
      "params": {}
    }
  ],
  "expect": {
    "observe": {
      "aEvents": [
        "notifications/tools/list_changed"
      ],
      "diags": [
        "before-ack"
      ],
      "a.state": "active"
    }
  },
  "mutants": [
    "drop-route"
  ]
}
