{
  "id": "ext/events/webhook/lifecycle-and-dedupe",
  "requirements": ["EXT-events-12", "EXT-events-24", "EXT-events-27", "EXT-events-30"],
  "pin": "wiki",
  "source": ["W/seps/3415-events-extension.md#Webhook-Based Delivery", "W/seps/3415-events-extension.md#Ordering and Delivery Guarantees"],
  "tier": "A",
  "binding": "any",
  "client": { "setup": { "secrets": ["whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"], "nowSec": 1700000000 } },
  "script": [
    { "do": "deliver", "as": "first", "webhookId": "msg_1", "timestamp": 1700000000, "subscriptionId": "sub-1",
      "rawBody": "{\"eventId\":\"e1\",\"name\":\"tick\",\"cursor\":\"c1\",\"data\":{\"n\":1}}", "signWith": [{ "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw" }] },
    { "do": "deliver", "as": "duplicate", "webhookId": "msg_2", "timestamp": 1700000000, "subscriptionId": "sub-1",
      "rawBody": "{\"eventId\":\"e1\",\"name\":\"tick\",\"cursor\":\"c1\",\"data\":{\"n\":1}}", "signWith": [{ "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw" }] },
    { "do": "deliver", "as": "gap", "webhookId": "msg_3", "timestamp": 1700000000, "subscriptionId": "sub-1",
      "rawBody": "{\"type\":\"gap\",\"truncated\":true,\"cursor\":\"c5\"}", "signWith": [{ "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw" }] },
    { "do": "deliver", "as": "terminated", "webhookId": "msg_4", "timestamp": 1700000000, "subscriptionId": "sub-1",
      "rawBody": "{\"type\":\"terminated\",\"reason\":\"expired\"}", "signWith": [{ "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw" }] }
  ],
  "expect": {
    "outcome": {
      "first": { "status": 200, "body": {} },
      "duplicate": { "status": 200, "body": {} },
      "gap": { "status": 200, "body": {} },
      "terminated": { "status": 200, "body": {} }
    },
    "events": [
      { "subscriptionId": "sub-1", "eventId": "e1", "name": "tick", "cursor": "c1", "data": { "n": 1 } }
    ],
    "controls": [
      { "kind": "gap", "subscriptionId": "sub-1", "truncated": true, "cursor": "c5" },
      { "kind": "terminated", "subscriptionId": "sub-1", "reason": "expired" }
    ]
  },
  "mutants": ["no-dedupe", "control-as-event", "drop-control-signals", "interpolate-data"]
}
