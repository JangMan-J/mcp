{
  "name": "@jangmanj/mcp-client",
  "version": "0.1.0",
  "description": "MCP 2026-07-28 client library: core, transports, auth, ops, MRTR/cache, OTEL telemetry, and extensions.",
  "license": "MIT",
  "author": "JangMan-J",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/mcp-client.git"
  },
  "homepage": "https://github.com/JangMan-J/mcp-client#readme",
  "bugs": {
    "url": "https://github.com/JangMan-J/mcp-client/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "default": "./dist/ops/index.js"
    },
    "./mrtr-cache": {
      "types": "./dist/mrtr-cache/index.d.ts",
      "default": "./dist/mrtr-cache/index.js"
    },
    "./telemetry-otel": {
      "types": "./dist/telemetry-otel/index.d.ts",
      "default": "./dist/telemetry-otel/index.js"
    },
    "./transport-http": {
      "types": "./dist/transport-http/index.d.ts",
      "default": "./dist/transport-http/index.js"
    },
    "./transport-stdio": {
      "types": "./dist/transport-stdio/index.d.ts",
      "default": "./dist/transport-stdio/index.js"
    },
    "./ext-events": {
      "types": "./dist/ext-events/index.d.ts",
      "default": "./dist/ext-events/index.js"
    },
    "./ext-server-cards": {
      "types": "./dist/ext-server-cards/index.d.ts",
      "default": "./dist/ext-server-cards/index.js"
    },
    "./ext-skills": {
      "types": "./dist/ext-skills/index.d.ts",
      "default": "./dist/ext-skills/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "test": "vitest run",
    "gen:schema": "node scripts/gen-schema-types.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check": "npm run build && npm run check:deps && npm run check:forbidden && npm test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "bootstrap:npm": "bash scripts/npm-bootstrap.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.8.0",
    "fast-check": "4.10.3",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
