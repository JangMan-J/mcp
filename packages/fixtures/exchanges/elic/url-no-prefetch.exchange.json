{
  "id": "elic/url-no-prefetch",
  "requirements": [
    "ELIC-URL-2",
    "ELIC-URL-3",
    "ELIC-AUTH-1"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/client/elicitation.md#Safe URL Handling",
    "specification/2026-07-28/client/elicitation.md#URL Mode Elicitation for OAuth Flows"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake",
    "setup": {
      "url": true,
      "browser": true,
      "replies": [
        {
          "resultType": "input_required",
          "inputRequests": {
            "visit": {
              "method": "elicitation/create",
              "params": {
                "message": "Visit",
                "mode": "url",
                "url": "https://xn--bcher-kva.example/path?q=1#fragment"
              }
            }
          }
        }
      ],
      "decisions": [
        "decline"
      ]
    }
  },
  "script": [
    {
      "do": "call",
      "method": "tools/call",
      "params": {}
    }
  ],
  "expect": {
    "observe": {
      "opened": [],
      "ui.0.url": "https://xn--bcher-kva.example/path?q=1#fragment",
      "wire.1.params.inputResponses.visit": {
        "action": "decline"
      }
    }
  },
  "mutants": [
    "no-ports"
  ]
}
