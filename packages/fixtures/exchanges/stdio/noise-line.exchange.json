{
  "id": "stdio/noise-line",
  "requirements": ["STDIO-STDOUT-1"],
  "pin": "tag",
  "source": ["S/basic/transports/stdio.md#Receiving Messages"],
  "tier": "B",
  "binding": "stdio",
  "server": { "era": "noisy" },
  "client": { "clock": "realtime" },
  "script": [
    { "do": "call", "as": "c1", "method": "tools/list", "idempotent": true },
    { "expect": "wire", "index": 0, "match": { "method": "tools/list" } },
    { "server": "result", "for": "c1", "result": { "resultType": "complete", "afterNoise": true } }
  ],
  "expect": {
    "outcome": {
      "c1": { "kind": "ok", "value.afterNoise": true }
    },
    "wire": { "totalRequests": 1 }
  },
  "mutants": ["crash-on-first-noise-line", "ignore-noise-budget"]
}
