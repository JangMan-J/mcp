{
  "id": "smoke/version-retry-32022",
  "requirements": ["VER-2", "VER-4"],
  "pin": "tag",
  "source": ["S/basic/versioning.md#Protocol Version Negotiation"],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "setup": { "supportedVersions": ["2026-07-28"] },
    "clock": "fake"
  },
  "script": [
    { "do": "call", "as": "c1", "method": "tools/list", "idempotent": true },
    { "expect": "wire", "index": 0 },
    {
      "server": "error",
      "for": "c1",
      "error": {
        "code": -32022,
        "message": "Unsupported protocol version",
        "data": { "requested": "2026-07-28", "supported": ["2026-07-28"] }
      }
    },
    { "expect": "wire", "index": 1 },
    { "server": "result", "for": "c1", "result": { "resultType": "complete", "tools": [] } }
  ],
  "expect": {
    "outcome": {
      "c1": { "kind": "ok", "meta.attempts": 2 }
    },
    "wire": {
      "distinctIds": true,
      "totalRequests": 2,
      "never": ["initialize"]
    }
  },
  "mutants": ["ignore-version-retry"]
}
