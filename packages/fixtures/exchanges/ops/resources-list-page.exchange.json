{
  "id": "ops/resources-list-page",
  "requirements": [
    "OPS-RES-1",
    "OPS-RES-6",
    "OPS-RES-7"
  ],
  "pin": "tag",
  "source": [
    "S/server/resources.md#Listing Resources"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "op": "resources.list",
      "args": []
    },
    {
      "server": "result",
      "result": {
        "resources": [
          {
            "uri": "file:///a",
            "name": "a",
            "annotations": {
              "priority": 2
            }
          },
          {
            "uri": "not a uri",
            "name": "b"
          }
        ]
      }
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "ok",
        "value.items.length": 2,
        "value.items.0.issues.0": "annotation-priority-out-of-range",
        "value.items.1.issues.0": "invalid-uri"
      }
    }
  },
  "mutants": []
}
