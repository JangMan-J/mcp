{
  "id": "mrtr/parallel-calls-isolated-state",
  "requirements": [
    "MRTR-C-7",
    "MRTR-MODE-1"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/patterns/mrtr.md#Client Requirements (Basic Workflow)",
    "specification/2026-07-28/basic/patterns/mrtr.md#Basic Workflow"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake",
    "setup": {
      "replies": [
        {
          "resultType": "input_required",
          "requestState": "first"
        },
        {
          "resultType": "input_required",
          "requestState": "second"
        }
      ]
    }
  },
  "script": [
    {
      "do": "call",
      "method": "tools/call",
      "params": {
        "name": "n"
      },
      "manual": true,
      "as": "a"
    },
    {
      "do": "call",
      "method": "tools/call",
      "params": {
        "name": "n"
      },
      "manual": true,
      "as": "b"
    },
    {
      "do": "resume",
      "target": "b",
      "as": "bb"
    },
    {
      "do": "resume",
      "target": "a",
      "as": "aa"
    }
  ],
  "expect": {
    "observe": {
      "wire.2.params.requestState": "second",
      "wire.3.params.requestState": "first"
    }
  },
  "mutants": [
    "strip-state"
  ]
}
