{
  "id": "ops/prompts-get-embedded-resource",
  "requirements": [
    "OPS-PROMPT-3"
  ],
  "pin": "tag",
  "source": [
    "S/server/prompts.md#Embedded Resources"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "op": "prompts.get",
      "args": [
        "p"
      ]
    },
    {
      "server": "result",
      "result": {
        "messages": [
          {
            "role": "user",
            "content": {
              "type": "resource",
              "resource": {
                "uri": "file:///a.txt",
                "mimeType": "text/plain",
                "text": "A"
              }
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "ok",
        "value.messages.0.content.type": "resource",
        "value.messages.0.content.issues.length": 0
      }
    }
  },
  "mutants": [
    "drop-embedded-resource"
  ]
}
