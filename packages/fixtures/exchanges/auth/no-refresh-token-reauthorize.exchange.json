{
  "id": "auth/no-refresh-token-reauthorize",
  "requirements": [
    "AUTH-REFRESH-2"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/authorization/index.md#Refresh Tokens"
  ],
  "tier": "B",
  "binding": "http",
  "client": {
    "tokenReplies": [
      {
        "body": {
          "token_type": "Bearer",
          "access_token": "fixture-token-1",
          "expires_in": 1
        }
      }
    ]
  },
  "script": [
    {
      "do": "challenge"
    },
    {
      "do": "advance",
      "ms": 1001
    },
    {
      "expect": "header",
      "value": "Bearer fixture-token-2"
    },
    {
      "expect": "counts",
      "match": {
        "open": 2,
        "token": 2
      }
    },
    {
      "expect": "form",
      "match": {
        "grant_type": "authorization_code"
      },
      "index": 1
    }
  ],
  "expect": {},
  "mutants": [
    "no-provider"
  ]
}
