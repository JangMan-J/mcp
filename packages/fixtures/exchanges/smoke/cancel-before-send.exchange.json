{
  "id": "smoke/cancel-before-send",
  "requirements": ["EDGE-6"],
  "pin": "tag",
  "source": ["S/basic/patterns/cancellation.md#Behavior Requirements"],
  "tier": "A",
  "binding": "stdio",
  "client": { "clock": "fake" },
  "script": [
    { "do": "call", "as": "c1", "method": "tools/call", "params": { "name": "create_item" }, "abortBeforeSend": true }
  ],
  "expect": {
    "outcome": {
      "c1": { "kind": "cancelled", "wasSent": false }
    },
    "wire": {
      "totalRequests": 0,
      "never": ["tools/call", "notifications/cancelled"]
    }
  },
  "mutants": ["send-cancel-when-aborted-before-send"]
}
