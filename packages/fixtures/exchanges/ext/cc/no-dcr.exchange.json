{
  "id": "ext/cc/no-dcr",
  "requirements": [
    "EXT-cc-10"
  ],
  "pin": "ext-page",
  "source": [
    "extensions/auth/oauth-client-credentials.md#What it is"
  ],
  "tier": "A",
  "binding": "http",
  "client": {
    "mode": "jwt-es256"
  },
  "script": [
    {
      "do": "header"
    },
    {
      "expect": "outcome",
      "value": {
        "authorization": "Bearer tok-1"
      }
    },
    {
      "expect": "no-registration"
    },
    {
      "expect": "fetches",
      "values": [
        "GET https://mcp.test/.well-known/oauth-protected-resource/rpc",
        "GET https://as.test/.well-known/oauth-authorization-server/tenant",
        "POST https://as.test/token"
      ]
    }
  ],
  "expect": {},
  "mutants": [
    "register-first"
  ]
}
