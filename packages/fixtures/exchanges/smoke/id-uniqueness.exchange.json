{
  "id": "smoke/id-uniqueness",
  "requirements": ["WIRE-ID-1"],
  "pin": "tag",
  "source": ["S/basic/index.md#Requests"],
  "tier": "A",
  "binding": "stdio",
  "client": { "clock": "fake" },
  "script": [
    { "do": "call", "as": "c1", "method": "tools/list", "idempotent": true },
    { "expect": "wire", "index": 0, "capture": { "id1": "id" } },
    { "do": "call", "as": "c2", "method": "prompts/list", "idempotent": true },
    { "expect": "wire", "index": 1, "capture": { "id2": "id" } },
    { "server": "result", "for": "c1", "result": { "resultType": "complete", "tools": [] } },
    { "server": "result", "for": "c2", "result": { "resultType": "complete", "prompts": [] } }
  ],
  "expect": {
    "outcome": {
      "c1": { "kind": "ok" },
      "c2": { "kind": "ok" }
    },
    "wire": {
      "distinctIds": true,
      "totalRequests": 2
    }
  },
  "mutants": ["allow-duplicate-id"]
}
