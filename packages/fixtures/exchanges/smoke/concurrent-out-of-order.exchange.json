{
  "id": "smoke/concurrent-out-of-order",
  "requirements": ["EDGE-1"],
  "pin": "tag",
  "source": ["S/basic/index.md#Responses"],
  "tier": "A",
  "binding": "stdio",
  "client": { "clock": "fake" },
  "script": [
    { "do": "call", "as": "c1", "method": "tools/call", "params": { "name": "first" }, "idempotent": true },
    { "do": "call", "as": "c2", "method": "tools/call", "params": { "name": "second" }, "idempotent": true },
    { "expect": "wire", "index": 0 },
    { "expect": "wire", "index": 1 },
    { "server": "result", "for": "c2", "result": { "resultType": "complete", "tag": "second-ok" } },
    { "server": "result", "for": "c1", "result": { "resultType": "complete", "tag": "first-ok" } }
  ],
  "expect": {
    "outcome": {
      "c1": { "kind": "ok", "value.tag": "first-ok" },
      "c2": { "kind": "ok", "value.tag": "second-ok" }
    },
    "wire": {
      "distinctIds": true,
      "totalRequests": 2
    }
  },
  "mutants": ["cross-talk-responses"]
}
