{
  "id": "stdio/shutdown-escalation",
  "requirements": ["STDIO-SHUT-1"],
  "pin": "tag",
  "source": ["S/basic/transports/stdio.md#Shutdown"],
  "tier": "B",
  "binding": "stdio",
  "client": { "clock": "realtime" },
  "script": [
    { "do": "call", "as": "c1", "method": "tools/list", "idempotent": true },
    { "expect": "wire", "index": 0 },
    { "server": "result", "for": "c1", "result": { "resultType": "complete" } }
  ],
  "expect": {
    "outcome": {
      "c1": { "kind": "ok" }
    }
  },
  "mutants": ["sigkill-first-without-stdin-close"]
}
