{
  "id": "ext/cc/jwt-claims-core",
  "requirements": [
    "EXT-cc-4"
  ],
  "pin": "ext-page",
  "source": [
    "extensions/auth/oauth-client-credentials.md#JWT Bearer Assertions (recommended)"
  ],
  "tier": "A",
  "binding": "http",
  "client": {
    "mode": "jwt-es256"
  },
  "script": [
    {
      "do": "header"
    },
    {
      "expect": "outcome",
      "value": {
        "authorization": "Bearer tok-1"
      }
    },
    {
      "expect": "jwt",
      "header": {
        "alg": "ES256",
        "kid": "k1"
      },
      "claims": {
        "iss": "client-1",
        "sub": "client-1",
        "aud": "https://as.test/tenant"
      },
      "present": [
        "exp",
        "iat",
        "jti"
      ]
    },
    {
      "expect": "form",
      "match": {
        "grant_type": "client_credentials",
        "client_assertion_type": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
        "client_assertion": "*",
        "resource": "https://mcp.test/rpc"
      },
      "absent": [
        "client_id",
        "client_secret",
        "assertion"
      ]
    }
  ],
  "expect": {},
  "mutants": [
    "aud-token-endpoint",
    "drop-exp",
    "iss-not-client-id"
  ]
}
