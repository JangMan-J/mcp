{
  "id": "cache/resource-updated-invalidates-uri",
  "requirements": [
    "SUB-INV-1"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/server/resources.md#Subscriptions"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake",
    "setup": {
      "replies": [
        {
          "resultType": "complete",
          "cacheScope": "private",
          "ttlMs": 100,
          "v": 1
        },
        {
          "resultType": "complete",
          "cacheScope": "private",
          "ttlMs": 100,
          "v": 2
        },
        {
          "resultType": "complete",
          "cacheScope": "private",
          "ttlMs": 100,
          "v": 3
        }
      ]
    }
  },
  "script": [
    {
      "do": "call",
      "method": "resources/read",
      "params": {
        "uri": "a"
      },
      "cacheOnly": true,
      "as": "call"
    },
    {
      "do": "call",
      "method": "resources/read",
      "params": {
        "uri": "b"
      },
      "cacheOnly": true,
      "as": "call"
    },
    {
      "do": "notify-cache",
      "method": "notifications/resources/updated",
      "params": {
        "uri": "a"
      }
    },
    {
      "do": "call",
      "method": "resources/read",
      "params": {
        "uri": "b"
      },
      "cacheOnly": true,
      "as": "other"
    },
    {
      "do": "call",
      "method": "resources/read",
      "params": {
        "uri": "a"
      },
      "cacheOnly": true,
      "as": "call"
    }
  ],
  "expect": {
    "observe": {
      "other.meta.cache": "hit",
      "call.value.v": 3
    }
  },
  "mutants": [
    "skip-invalidation"
  ]
}
