{
  "id": "wire/cancelled-non-listen-ignored",
  "requirements": [
    "WIRE-CANCEL-4"
  ],
  "pin": "tag",
  "source": [
    "S/basic/patterns/cancellation.md#Behavior Requirements"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "method": "tools/list"
    },
    {
      "expect": "wire",
      "index": 0
    },
    {
      "server": "notify",
      "for": "c1",
      "notification": {
        "jsonrpc": "2.0",
        "method": "notifications/cancelled",
        "params": {
          "requestId": 1,
          "reason": "server says stop"
        }
      }
    },
    {
      "server": "result",
      "for": "c1",
      "result": {
        "resultType": "complete",
        "tools": []
      }
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "ok"
      }
    },
    "stats": {
      "droppedCancelled": 1
    },
    "notifications": {
      "c1": 0
    }
  },
  "mutants": [
    "pass-all-notifications"
  ]
}
