{
  "id": "ext/tasks/create-and-poll",
  "tier": "A",
  "binding": "any",
  "pin": "ext-page",
  "source": [
    "W/extensions/tasks/overview.md#For MCP clients"
  ],
  "requirements": [
    "EXT-tasks-1",
    "EXT-tasks-2",
    "EXT-tasks-3",
    "EXT-tasks-4",
    "EXT-tasks-13"
  ],
  "client": {},
  "script": [
    {
      "do": "caps"
    },
    {
      "do": "create",
      "reply": {
        "resultType": "task",
        "taskId": "t",
        "status": "working",
        "pollIntervalMs": 125
      }
    },
    {
      "do": "poll",
      "reply": {
        "resultType": "task",
        "taskId": "t",
        "status": "completed",
        "result": {
          "x": 1
        }
      }
    },
    {
      "do": "create",
      "reply": {
        "resultType": "task",
        "taskId": "t",
        "status": "failed",
        "error": {
          "message": "failed"
        }
      }
    },
    {
      "do": "poll"
    },
    {
      "do": "create",
      "reply": {
        "resultType": "task",
        "taskId": "t",
        "status": "cancelled"
      }
    },
    {
      "do": "poll"
    }
  ],
  "expect": {
    "caps": [
      {
        "extensions": {
          "io.modelcontextprotocol/tasks": {}
        }
      },
      {}
    ],
    "time": 125,
    "calls": [
      "tools/call",
      "tasks/get",
      "tools/call",
      "tools/call"
    ],
    "outcomes": [
      "task-handle",
      {
        "x": 1
      },
      "task-handle",
      {
        "message": "failed"
      },
      "task-handle",
      {
        "resultType": "task",
        "taskId": "t",
        "status": "cancelled"
      }
    ]
  },
  "mutants": [
    "tasks-ignore-interval"
  ]
}
