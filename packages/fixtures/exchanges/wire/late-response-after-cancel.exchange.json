{
  "id": "wire/late-response-after-cancel",
  "requirements": [
    "WIRE-CANCEL-3"
  ],
  "pin": "tag",
  "source": [
    "S/basic/patterns/cancellation.md#Behavior Requirements"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "method": "tools/list"
    },
    {
      "expect": "wire",
      "index": 0,
      "capture": {
        "id1": "id"
      }
    },
    {
      "do": "abort",
      "target": "c1"
    },
    {
      "server": "result",
      "id": "$id1",
      "result": {
        "resultType": "complete",
        "tools": []
      }
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "cancelled",
        "wasSent": true
      }
    },
    "stats": {
      "lateResponses": 1,
      "localAbortSettles": 1
    },
    "wire": {
      "totalRequests": 1
    }
  },
  "mutants": [
    "no-settle-on-abort"
  ]
}
