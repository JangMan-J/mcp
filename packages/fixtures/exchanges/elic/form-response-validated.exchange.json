{
  "id": "elic/form-response-validated",
  "requirements": [
    "ELIC-MODE-1",
    "ELIC-FORM-1",
    "ELIC-UI-1",
    "ELIC-RESP-1",
    "ELIC-RESP-2"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/client/elicitation.md#Elicitation Requests",
    "specification/2026-07-28/client/elicitation.md#Requested Schema",
    "specification/2026-07-28/client/elicitation.md#User Interaction Model",
    "specification/2026-07-28/client/elicitation.md#Response Actions",
    "specification/2026-07-28/client/elicitation.md#Form Mode Security"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake",
    "setup": {
      "form": true,
      "replies": [
        {
          "resultType": "input_required",
          "inputRequests": {
            "pick": {
              "method": "elicitation/create",
              "params": {
                "message": "Choose a city",
                "requestedSchema": {
                  "type": "object",
                  "properties": {
                    "city": {
                      "type": "string",
                      "minLength": 1,
                      "default": "Oslo"
                    }
                  },
                  "required": [
                    "city"
                  ]
                }
              }
            }
          }
        }
      ],
      "decisions": [
        {
          "action": "accept",
          "content": {
            "city": 3
          }
        },
        {
          "action": "accept",
          "content": {
            "city": ""
          }
        }
      ]
    }
  },
  "script": [
    {
      "do": "call",
      "method": "tools/call",
      "params": {}
    }
  ],
  "expect": {
    "observe": {
      "ui.1.invalidPrevious": true,
      "ui.0.defaults": {
        "city": "Oslo"
      },
      "wire.1.params.inputResponses.pick": {
        "action": "cancel"
      },
      "diags": [
        "invalid-elicitation-response"
      ]
    }
  },
  "mutants": [
    "raw-result"
  ]
}
