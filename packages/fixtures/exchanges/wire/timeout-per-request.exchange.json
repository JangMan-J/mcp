{
  "id": "wire/timeout-per-request",
  "requirements": [
    "WIRE-TO-1",
    "ERR-LOCAL-1"
  ],
  "pin": "tag",
  "source": [
    "S/basic/patterns/cancellation.md#Timeouts",
    "S/basic/index.md#Error Codes"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "method": "tools/list",
      "timeoutMs": 500
    },
    {
      "expect": "wire",
      "index": 0
    },
    {
      "advance": 500
    },
    {
      "server": "result",
      "for": "c1",
      "result": {
        "resultType": "complete",
        "tools": []
      }
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "transport-failure",
        "failure.kind": "timeout",
        "safeToRetry": true
      }
    },
    "stats": {
      "lateResponses": 1
    }
  },
  "mutants": [
    "ignore-per-request-timeout"
  ]
}
