{
  "id": "stdio/cancel-inflight",
  "requirements": ["STDIO-CANCEL-1"],
  "pin": "tag",
  "source": ["S/basic/transports/stdio.md#Cancellation"],
  "tier": "B",
  "binding": "stdio",
  "client": { "clock": "realtime" },
  "script": [
    { "do": "call", "as": "c1", "method": "tools/list", "idempotent": true },
    { "expect": "wire", "index": 0 },
    { "do": "abort", "target": "c1" }
  ],
  "expect": {
    "outcome": {
      "c1": { "kind": "cancelled", "wasSent": true }
    }
  },
  "mutants": ["omit-notifications-cancelled", "write-queued-cancelled-request"]
}
