{
  "id": "auth/scope-selection-priority",
  "requirements": [
    "AUTH-SCOPE-1"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/authorization/index.md#Scope Selection Strategy"
  ],
  "tier": "B",
  "binding": "http",
  "client": {},
  "script": [
    {
      "do": "challenge",
      "challenge": "Bearer resource_metadata=\"https://mcp.test/custom-prm\", scope=\"other\""
    },
    {
      "expect": "open",
      "url": "https://as.test/authorize",
      "match": {
        "scope": "other"
      }
    },
    {
      "do": "challenge"
    },
    {
      "expect": "open",
      "url": "https://as.test/authorize",
      "match": {
        "scope": "read"
      },
      "index": 1
    },
    {
      "server": "update",
      "prm": {
        "scopes_supported": []
      }
    },
    {
      "do": "challenge"
    },
    {
      "expect": "open",
      "url": "https://as.test/authorize",
      "match": {},
      "index": 2,
      "absent": [
        "scope"
      ]
    }
  ],
  "expect": {},
  "mutants": [
    "wrong-scope"
  ]
}
