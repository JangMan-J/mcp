{
  "id": "ext/card/well-known-catalog",
  "requirements": ["EXT-card-2"],
  "pin": "ext-server-card@28db12c9b4a379489d46e49bf1bd4a991f05c9b7",
  "source": ["seps/2127-mcp-server-cards.md#Discovery"],
  "tier": "A",
  "binding": "http",
  "serve": {
    "https://example.test/.well-known/ai-catalog.json": {
      "body": { "entries": [
        { "type": "mcp-server-card", "data": { "$schema": "s", "name": "inline/one", "version": "1", "description": "d" } },
        { "type": "a2a-agent-card", "url": "https://example.test/agent.json" },
        { "type": "mcp-server-card", "url": "/cards/two.json" }
      ] }
    },
    "https://example.test/cards/two.json": { "body": { "$schema": "s", "name": "remote/two", "version": "2", "description": "d" } }
  },
  "script": [
    { "do": "domain", "origin": "example.test" },
    { "expect": "names", "values": ["inline/one", "remote/two"] },
    { "expect": "fetches", "values": ["GET https://example.test/.well-known/ai-catalog.json", "GET https://example.test/cards/two.json"] }
  ],
  "expect": {},
  "mutants": ["skip-inline"]
}
