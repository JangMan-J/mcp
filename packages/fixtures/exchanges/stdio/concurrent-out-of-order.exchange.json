{
  "id": "stdio/concurrent-out-of-order",
  "requirements": ["STDIO-CONC-1", "STDIO-WRITE-1"],
  "pin": "tag",
  "source": ["S/basic/transports/stdio.md#Receiving Messages", "S/basic/transports/stdio.md#Sending Messages"],
  "tier": "B",
  "binding": "stdio",
  "client": { "clock": "realtime" },
  "script": [
    { "do": "call", "as": "c1", "method": "tools/call", "params": { "name": "first" }, "idempotent": true },
    { "do": "call", "as": "c2", "method": "tools/call", "params": { "name": "second" }, "idempotent": true },
    { "expect": "wire", "index": 0 },
    { "expect": "wire", "index": 1 },
    { "server": "result", "for": "c2", "result": { "resultType": "complete", "order": "second" } },
    { "server": "result", "for": "c1", "result": { "resultType": "complete", "order": "first" } }
  ],
  "expect": {
    "outcome": {
      "c1": { "kind": "ok", "value.order": "first" },
      "c2": { "kind": "ok", "value.order": "second" }
    },
    "wire": { "distinctIds": true, "totalRequests": 2 }
  },
  "mutants": ["fifo-response-matching"]
}
