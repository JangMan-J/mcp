{
  "id": "cache/cursor-in-key",
  "requirements": [
    "CACHE-KEY-1",
    "CACHE-PAGE-1"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/server/utilities/caching.md#Cache Key",
    "specification/2026-07-28/server/utilities/caching.md#Interaction with Pagination"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake",
    "setup": {
      "replies": [
        {
          "resultType": "complete",
          "cacheScope": "private",
          "ttlMs": 100,
          "v": 1
        },
        {
          "resultType": "complete",
          "cacheScope": "private",
          "ttlMs": 100,
          "v": 2
        }
      ]
    }
  },
  "script": [
    {
      "do": "call",
      "method": "tools/list",
      "params": {},
      "cacheOnly": true,
      "as": "call"
    },
    {
      "do": "advance",
      "ms": 50
    },
    {
      "do": "call",
      "method": "tools/list",
      "params": {
        "cursor": "next"
      },
      "cacheOnly": true,
      "as": "call"
    },
    {
      "do": "advance",
      "ms": 51
    },
    {
      "do": "call",
      "method": "tools/list",
      "params": {
        "cursor": "next",
        "_meta": {
          "trace": "new"
        }
      },
      "cacheOnly": true,
      "as": "call"
    }
  ],
  "expect": {
    "observe": {
      "wire.length": 2,
      "call.value.v": 2,
      "call.meta.cache": "hit"
    }
  },
  "mutants": [
    "ignore-cursor"
  ]
}
