{
  "name": "@jangmanj/mcp",
  "version": "0.12.3",
  "description": "MCP 2026-07-28 client and server library: push events/subscriptions, core, transports, auth, ops, MRTR/cache, OTEL telemetry, and extensions.",
  "license": "MIT",
  "author": "JangMan-J",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./adapters/pi/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/mcp-client.git"
  },
  "homepage": "https://github.com/JangMan-J/mcp-client#readme",
  "bugs": {
    "url": "https://github.com/JangMan-J/mcp-client/issues"
  },
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "adapters/pi",
    "!adapters/pi/test",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./server-events": {
      "types": "./dist/server-events/index.d.ts",
      "default": "./dist/server-events/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server-transport": {
      "types": "./dist/server-transport/index.d.ts",
      "default": "./dist/server-transport/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "default": "./dist/ops/index.js"
    },
    "./mrtr-cache": {
      "types": "./dist/mrtr-cache/index.d.ts",
      "default": "./dist/mrtr-cache/index.js"
    },
    "./telemetry-otel": {
      "types": "./dist/telemetry-otel/index.d.ts",
      "default": "./dist/telemetry-otel/index.js"
    },
    "./transport-http": {
      "types": "./dist/transport-http/index.d.ts",
      "default": "./dist/transport-http/index.js"
    },
    "./transport-stdio": {
      "types": "./dist/transport-stdio/index.d.ts",
      "default": "./dist/transport-stdio/index.js"
    },
    "./ext-events": {
      "types": "./dist/ext-events/index.d.ts",
      "default": "./dist/ext-events/index.js"
    },
    "./ext-server-cards": {
      "types": "./dist/ext-server-cards/index.d.ts",
      "default": "./dist/ext-server-cards/index.js"
    },
    "./ext-skills": {
      "types": "./dist/ext-skills/index.d.ts",
      "default": "./dist/ext-skills/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vitest run",
    "gen:schema": "node scripts/gen-schema-types.mjs",
    "gen:spec-matrix": "node scripts/gen-spec-matrix.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:spec-matrix": "node scripts/gen-spec-matrix.mjs --check",
    "check:spec-drift": "node scripts/check-spec-drift.mjs",
    "check": "npm run build && npm run typecheck && npm run check:deps && npm run check:spec-matrix && npm test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "bootstrap:npm": "bash scripts/npm-bootstrap.sh",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.8.0",
    "fast-check": "4.10.3",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
