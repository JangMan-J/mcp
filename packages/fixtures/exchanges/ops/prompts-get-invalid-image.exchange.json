{
  "id": "ops/prompts-get-invalid-image",
  "requirements": [
    "OPS-PROMPT-4"
  ],
  "pin": "tag",
  "source": [
    "S/server/prompts.md#Image Content"
  ],
  "tier": "A",
  "binding": "any",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "op": "prompts.get",
      "args": [
        "p"
      ]
    },
    {
      "server": "result",
      "result": {
