{
  "id": "wire/no-log-level",
  "requirements": [
    "WIRE-LOG-1",
    "EDGE-33"
  ],
  "pin": "tag",
  "source": [
    "S/basic/index.md#`_meta`",
    "S/server/utilities/logging.md#Per-request log level"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "method": "tools/list"
    },
    {
      "expect": "wire",
      "index": 0
    },
    {
      "server": "notify",
      "for": "c1",
      "notification": {
        "jsonrpc": "2.0",
        "method": "notifications/message",
        "params": {
          "level": "info",
          "data": "unsolicited"
        }
      }
    },
    {
      "server": "result",
      "for": "c1",
      "result": {
        "resultType": "complete",
        "tools": []
      }
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "ok"
      }
    },
    "stats": {
      "droppedLogMessages": 1
    },
    "notifications": {
      "c1": 0
    },
    "wire": {
      "totalRequests": 1,
      "never": [
        "logLevel"
      ]
    }
  },
  "mutants": [
    "pass-all-notifications"
  ]
}
