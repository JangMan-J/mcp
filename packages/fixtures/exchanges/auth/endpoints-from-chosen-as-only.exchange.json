{
  "id": "auth/endpoints-from-chosen-as-only",
  "requirements": [
    "AUTH-MIX-1"
  ],
  "pin": "tag",
  "source": [
    "specification/2026-07-28/basic/authorization/security-considerations.md#Mix-Up Attacks"
  ],
  "tier": "A",
  "binding": "http",
  "client": {
    "registration": "prompt"
  },
  "script": [
    {
      "do": "challenge"
    },
    {
      "server": "update",
      "prm": {
        "authorization_servers": [
          "https://second.test"
        ]
      },
      "metadata": {
        "issuer": "https://second.test",
        "authorization_endpoint": "https://second.test/authorize",
        "token_endpoint": "https://second.test/token"
      },
      "callback": {
        "iss": "https://second.test"
      }
    },
    {
      "do": "challenge"
    },
    {
      "expect": "fetches",
      "values": [
        "GET https://mcp.test/custom-prm",
        "GET https://as.test/.well-known/oauth-authorization-server/tenant",
        "POST https://as.test/token",
        "GET https://mcp.test/custom-prm",
        "GET https://second.test/.well-known/oauth-authorization-server",
        "POST https://second.test/token"
      ]
    },
    {
      "expect": "prompt",
      "match": {
        "kind": "client-info",
        "issuer": "https://second.test"
      },
      "index": 2
    },
    {
      "expect": "header",
      "value": "Bearer fixture-token-2"
    }
  ],
  "expect": {},
  "mutants": [
    "no-provider"
  ]
}
