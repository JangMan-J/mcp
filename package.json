{
  "name": "mcp-client-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "remove:ext-client-credentials": "node scripts/check-remove-ext.mjs ext-client-credentials",
    "remove:ext-enterprise-auth": "node scripts/check-remove-ext.mjs ext-enterprise-auth",
    "remove:ext-tasks": "node scripts/check-remove-ext.mjs ext-tasks",
    "remove:ext-skills": "node scripts/check-remove-ext.mjs ext-skills",
    "test": "vitest run",
    "gate": "bash scripts/gate.sh",
    "req:build": "node scripts/req-build.mjs",
    "gen:schema": "node scripts/gen-schema-types.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check:deps-doc": "node scripts/check-deps-doc.mjs",
    "check:coverage": "node packages/conformance/dist/cli.js check-coverage"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.8.0",
    "fast-check": "4.10.3",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
