{
  "id": "wire/capabilities-match-registry",
  "requirements": [
    "WIRE-META-2",
    "DEP-ROOTS-1",
    "DEP-SAMPLING-1"
  ],
  "pin": "tag",
  "source": [
    "S/basic/index.md#General fields"
  ],
  "tier": "A",
  "binding": "stdio",
  "client": {
    "setup": {
      "extensions": [
        {
          "id": "io.example/widgets",
          "capabilities": {
            "io.example/widgets": {
              "version": 1
            }
          }
        }
      ]
    },
    "clock": "fake"
  },
  "script": [
    {
      "do": "call",
      "as": "c1",
      "method": "tools/list"
    },
    {
      "expect": "wire",
      "index": 0,
      "match": {
        "params._meta.io.modelcontextprotocol/clientCapabilities": {
          "io.example/widgets": {
            "version": 1
          }
        }
      }
    },
    {
      "server": "result",
      "for": "c1",
      "result": {
        "resultType": "complete",
        "tools": []
      }
    }
  ],
  "expect": {
    "outcome": {
      "c1": {
        "kind": "ok"
      }
    },
    "wire": {
      "totalRequests": 1,
      "never": [
        "roots",
        "sampling",
        "elicitation"
      ]
    }
  },
  "mutants": [
    "ignore-extension-registry"
  ]
}
